{
  "name": "intervaltree",
  "type": "module",
  "version": "2.0.0",
  "description": "Interval tree for JavaScript",
  "author": "Jordan Baker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hexsprite/intervaltree"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npx tsup",
    "postbuild": "node -e \"const fs=require('fs');for(const f of ['dist/index.js','dist/index.cjs']){const s=fs.readFileSync(f,'utf8');if(/DEBUG = true/.test(s)||!s.includes('INTERVALTREE_DEBUG'))throw new Error(f+': debug flag frozen on or missing')}\"",
    "clean": "rimraf dist",
    "prebuild": "rimraf dist",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --no-watch",
    "test:watch": "vitest",
    "model-check": "vitest run --config vitest.model.config.ts",
    "bench": "NODE_ENV=production vitest bench --run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "expect": "^30.5.1",
    "fast-check": "^4.9.0",
    "pure-rand": "^7.0.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  }
}
